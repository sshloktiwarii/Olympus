#!/usr/bin/env python3
"""
Apex Master Orchestrator CLI.
Provides zero-friction single-command lifecycle management for the entire Apex Stack:
    ./bin/apex start    - Boot all 5 pillars and launch the steering console
    ./bin/apex status   - Check real-time process telemetry, PIDs, and bound ports
    ./bin/apex stop     - Gracefully terminate all background daemons
    ./bin/apex test     - Run the automated chaos-monkey adversarial test suite
"""

import argparse
import json
import os
import signal
import subprocess
import sys
import time
import webbrowser
from pathlib import Path
from typing import Dict, Optional

# Locate directories
BIN_DIR = Path(__file__).resolve().parent
APEX_ROOT = BIN_DIR.parent
APEX_STATE_DIR = APEX_ROOT / ".apex"
PIDS_FILE = APEX_STATE_DIR / "pids.json"
PORTS_FILE = APEX_STATE_DIR / "ports.json"
LOGS_DIR = APEX_STATE_DIR / "logs"

# Styling constants
BOLD = "\033[1m"
RESET = "\033[0m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
CYAN = "\033[36m"
MAGENTA = "\033[35m"


def ensure_state_dirs():
    APEX_STATE_DIR.mkdir(parents=True, exist_ok=True)
    LOGS_DIR.mkdir(parents=True, exist_ok=True)


def is_pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def get_active_pids() -> Dict[str, int]:
    if PIDS_FILE.exists():
        try:
            return json.loads(PIDS_FILE.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def save_pids(pids: Dict[str, int]):
    ensure_state_dirs()
    PIDS_FILE.write_text(json.dumps(pids, indent=2), encoding="utf-8")


def get_active_ports() -> Dict[str, int]:
    if PORTS_FILE.exists():
        try:
            return json.loads(PORTS_FILE.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def start_service(name: str, cmd: list, cwd: Path) -> tuple[subprocess.Popen, int]:
    log_out = open(LOGS_DIR / f"{name}.log", "a")
    proc = subprocess.Popen(
        cmd,
        cwd=str(cwd),
        stdout=log_out,
        stderr=subprocess.STDOUT,
        preexec_fn=os.setsid if hasattr(os, "setsid") else None,
    )
    try:
        pgrp = os.getpgid(proc.pid)
    except OSError:
        pgrp = proc.pid
    return proc, pgrp


def cmd_start(args):
    ensure_state_dirs()
    active_pids = get_active_pids()

    # Check if already running
    running = {name: pid for name, pid in active_pids.items() if is_pid_alive(pid)}
    if len(running) == 4:
        print(f"{YELLOW}Apex Stack is already running with PIDs: {running}{RESET}")
        cmd_status(args)
        return

    print(f"\n{BOLD}{CYAN}=== BOOTING APEX STACK ARCHITECTURE ==={RESET}")
    print(f"{CYAN}Initializing 5 Micro-Pillars with Zero-Blocking Telemetry...{RESET}\n")

    pids = {}

    # 1. Apex-Gateway (Rust)
    gateway_dir = APEX_ROOT / "apex-gateway"
    gateway_bin = gateway_dir / "target" / "release" / "apex-gateway"
    if gateway_bin.exists():
        cmd = [str(gateway_bin)]
    else:
        cmd = ["cargo", "run", "--release", "--quiet"]
    pids = {}

    # 1. Apex-Gateway (Rust)
    gateway_dir = APEX_ROOT / "apex-gateway"
    gateway_bin = gateway_dir / "target" / "release" / "apex-gateway"
    if gateway_bin.exists():
        cmd = [str(gateway_bin)]
    else:
        cmd = ["cargo", "run", "--release", "--quiet"]
    print(f"  [1/4] Spawning {BOLD}Apex-Gateway{RESET} (L7 Inference Proxy)...", end="", flush=True)
    p_gw, pgrp_gw = start_service("apex-gateway", cmd, gateway_dir)
    pids["gateway"] = {"pid": p_gw.pid, "pgrp": pgrp_gw}
    print(f" {GREEN}[PID {p_gw.pid} | PGRP {pgrp_gw}]{RESET}")

    # 2. Apex-Core (Python)
    core_dir = APEX_ROOT / "apex-core"
    cmd_core = [sys.executable, "-m", "core.engine"]
    print(f"  [2/4] Spawning {BOLD}Apex-Core{RESET} (APFS CoW DAG Engine)...", end="", flush=True)
    p_core, pgrp_core = start_service("apex-core", cmd_core, core_dir)
    pids["core"] = {"pid": p_core.pid, "pgrp": pgrp_core}
    print(f" {GREEN}[PID {p_core.pid} | PGRP {pgrp_core}]{RESET}")

    # 3. Apex-Warden (Python)
    warden_dir = APEX_ROOT / "apex-warden"
    cmd_warden = [sys.executable, "apex_warden.py"]
    print(f"  [3/4] Spawning {BOLD}Apex-Warden{RESET} (Adaptive Memory Supervisor)...", end="", flush=True)
    p_warden, pgrp_warden = start_service("apex-warden", cmd_warden, warden_dir)
    pids["warden"] = {"pid": p_warden.pid, "pgrp": pgrp_warden}
    print(f" {GREEN}[PID {p_warden.pid} | PGRP {pgrp_warden}]{RESET}")

    # 4. Apex-Console (Vite/React)
    console_dir = APEX_ROOT / "apex-console"
    cmd_console = ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173"]
    print(f"  [4/4] Spawning {BOLD}Apex-Console{RESET} (Tauri/Vite UI)...", end="", flush=True)
    p_console, pgrp_console = start_service("apex-console", cmd_console, console_dir)
    pids["console"] = {"pid": p_console.pid, "pgrp": pgrp_console}
    print(f" {GREEN}[PID {p_console.pid} | PGRP {pgrp_console}]{RESET}")

    save_pids(pids)

    # Wait for dynamic port registration
    print(f"\n{YELLOW}Resolving dynamic ports from .apex/ports.json...{RESET}", end="", flush=True)
    ports = {}
    for _ in range(30):
        time.sleep(0.3)
        ports = get_active_ports()
        if "gateway" in ports and "core" in ports:
            break
    print(f" {GREEN}RESOLVED{RESET}")

    gw_port = ports.get("gateway", 8080)
    core_port = ports.get("core", 9000)

    print(f"\n{BOLD}{GREEN}✓ APEX STACK ONLINE AND FULLY SUPERVISED{RESET}")
    print(f"  • {BOLD}Apex-Gateway:{RESET}   http://localhost:{gw_port} (OpenAI /v1/chat/completions)")
    print(f"  • {BOLD}Apex-Core:{RESET}      http://localhost:{core_port} (WebSocket ws://localhost:{core_port}/ws)")
    print(f"  • {BOLD}Apex-Warden:{RESET}    Active (Thresholds: 85% SIGSTOP / 70% SIGCONT)")
    print(f"  • {BOLD}Apex-Console:{RESET}   http://localhost:5173\n")

    if args and not args.no_browser:
        try:
            webbrowser.open("http://localhost:5173")
        except Exception:
            pass


def cmd_stop(args=None):
    active_pids = get_active_pids()
    if not active_pids:
        print(f"{YELLOW}No running Apex Stack daemons detected in {PIDS_FILE}.{RESET}")
        return

    print(f"\n{BOLD}{RED}=== TERMINATING APEX STACK DAEMONS (PGRP TEARDOWN) ==={RESET}")
    for name, info in active_pids.items():
        pid = info["pid"] if isinstance(info, dict) else info
        pgrp = info.get("pgrp") if isinstance(info, dict) else pid

        if is_pid_alive(pid):
            print(f"  Killing process group {BOLD}{name}{RESET} (PID {pid} | PGRP {pgrp})...", end="", flush=True)
            # 1. Kill process group with SIGTERM
            if pgrp and hasattr(os, "killpg"):
                try:
                    os.killpg(pgrp, signal.SIGTERM)
                except (ProcessLookupError, PermissionError):
                    pass

            try:
                os.kill(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass

            time.sleep(0.2)

            # 2. Force SIGKILL on process group if any child is alive
            if pgrp and hasattr(os, "killpg"):
                try:
                    os.killpg(pgrp, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass

            if is_pid_alive(pid):
                try:
                    os.kill(pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass

            print(f" {GREEN}TERMINATED{RESET}")
        else:
            print(f"  Service {name} (PID {pid}) was not running.")

    if PIDS_FILE.exists():
        PIDS_FILE.unlink()
    print(f"{BOLD}{GREEN}All Apex Stack process groups cleanly wiped. Zero zombie PIDs remaining.{RESET}\n")


def cmd_status(args):
    active_pids = get_active_pids()
    ports = get_active_ports()

    print(f"\n{BOLD}{CYAN}=== APEX STACK RUNTIME TELEMETRY ==={RESET}\n")
    print(f"{'SERVICE':<16} {'STATUS':<12} {'PID':<8} {'PGRP':<8} {'PORT/ENDPOINT'}")
    print(f"{'-'*16} {'-'*12} {'-'*8} {'-'*8} {'-'*30}")

    services = [
        ("Apex-Gateway", "gateway", ports.get("gateway", 8080), f"http://127.0.0.1:{ports.get('gateway', 8080)}"),
        ("Apex-Core", "core", ports.get("core", 9000), f"ws://127.0.0.1:{ports.get('core', 9000)}/ws"),
        ("Apex-Warden", "warden", None, "Telemetry Daemon (Mach/sysctl)"),
        ("Apex-Console", "console", 5173, "http://127.0.0.1:5173"),
    ]

    for display_name, key, port, endpoint in services:
        info = active_pids.get(key)
        pid = info["pid"] if isinstance(info, dict) else info
        pgrp = info.get("pgrp") if isinstance(info, dict) else pid

        alive = is_pid_alive(pid) if pid else False
        status_str = f"{GREEN}ONLINE{RESET}" if alive else f"{RED}STOPPED{RESET}"
        pid_str = str(pid) if pid else "---"
        pgrp_str = str(pgrp) if pgrp else "---"
        print(f"{display_name:<16} {status_str:<21} {pid_str:<8} {pgrp_str:<8} {endpoint}")

    print("")

    print("")


def cmd_test(args):
    test_script = APEX_ROOT / "tests" / "chaos_adversary_test.py"
    if not test_script.exists():
        print(f"{RED}Test script not found at {test_script}{RESET}")
        sys.exit(1)

    print(f"\n{BOLD}{MAGENTA}=== RUNNING APEX CHAOS-MONKEY ADVERSARIAL SUITE ==={RESET}\n")
    res = subprocess.run([sys.executable, str(test_script)], cwd=str(APEX_ROOT))
    sys.exit(res.returncode)


def main():
    parser = argparse.ArgumentParser(description="Apex Master Orchestrator CLI")
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")

    # Start
    start_parser = subparsers.add_parser("start", help="Boot all 5 pillars and launch UI")
    start_parser.add_argument("--no-browser", action="store_true", help="Do not automatically open web browser")

    # Stop
    subparsers.add_parser("stop", help="Gracefully terminate all running Apex daemons")

    # Status
    subparsers.add_parser("status", help="Inspect real-time process PIDs and ports")

    # Test
    subparsers.add_parser("test", help="Run the automated chaos-monkey adversarial test harness")

    def signal_teardown(sig, frame):
        print(f"\n{YELLOW}Signal {sig} received. Initiating emergency process group teardown...{RESET}")
        cmd_stop()
        sys.exit(0)

    try:
        signal.signal(signal.SIGINT, signal_teardown)
        signal.signal(signal.SIGTERM, signal_teardown)
    except Exception:
        pass

    args = parser.parse_args()

    if args.command == "start":
        cmd_start(args)
    elif args.command == "stop":
        cmd_stop(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "test":
        cmd_test(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
